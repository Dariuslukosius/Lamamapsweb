{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // src/test/routes.test.ts imports the plain-JS deploy manifest that the
    // build scripts also read, and uses node:fs to read App.tsx back.
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals",
      "node"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}